{
    "files.watcherExclude": {
        "**/target/**": true
    },
    // 启用鼠标滚轮缩放功能
    "editor.mouseWheelZoom": true,
    // 调整整个 VS Code UI 界面缩放 (影响 Explorer 字体大小)
    "window.zoomLevel": 0.1,
    // 增加 Explorer 的嵌套缩进，使其更清晰
    "workbench.tree.indent": 15,
    "files.autoSave": "onWindowChange",
    "workbench.colorTheme": "Atom One Dark",
    // 启用文件保存时自动格式化
    "editor.formatOnSave": true,
    // 将 Rust 文件的格式化程序设置为 rust-analyzer
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
        // 自动插入闭包时的括号和分号
        "editor.autoClosingOvertype": "always",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // rust-analyzer 设置
    "rust-analyzer.checkOnSave": true, // 保存时自动运行 cargo check
    "rust-analyzer.check.command": "clippy", // 使用 clippy 替代 check 进行保存检查，更严谨
    "rust-analyzer.cargo.autoreload": true, // Cargo.toml 修改后自动重新加载
    "rust-analyzer.inlayHints.expressionAdjustmentHints.enable": "always", // 显示隐式类型转换提示
    "rust-analyzer.inlayHints.typeHints.enable": true, // 显示类型提示
    "rust-analyzer.inlayHints.parameterHints.enable": true, // 显示参数名提示
}